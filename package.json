{
  "name": "maitre",
  "version": "1.0.0",
  "description": "Maitre — carta digital por QR, pedido desde la mesa y gestión de sala para hostelería",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
